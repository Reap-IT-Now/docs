{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "REAP",
  "colors": {
    "primary": "#173E4F",
    "light": "#88C3DD",
    "dark": "#173E4F"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Documentation",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Integrations",
        "pages": [
          "integrations/slack"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/reap.svg",
    "dark": "/logo/reap.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@reapitnow.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "REAP website",
      "href": "https://reapitnow.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "links": [
      {
        "header": "REAP",
        "items": [
          {
            "label": "Website",
            "href": "https://reapitnow.ai"
          },
          {
            "label": "Blog",
            "href": "https://reapitnow.ai/blog"
          }
        ]
      },
      {
        "header": "Help",
        "items": [
          {
            "label": "Contact support",
            "href": "mailto:support@reapitnow.ai"
          }
        ]
      }
    ]
  },
  "description": "REAP documentation for connecting integrations and working with network incidents, network questions, and runbooks.",
  "appearance": {
    "default": "light",
    "strict": false
  },
  "fonts": {
    "family": "DM Sans"
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/",
      "permanent": true
    }
  ]
}
